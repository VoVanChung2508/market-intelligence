[Unit]
Description=Market Intelligence Daily Market Briefing via Telegram
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/market-intelligence
EnvironmentFile=-%h/market-intelligence/.env
ExecStart=%h/market-intelligence/.venv/bin/python -m backend.telegram_bot --briefing
TimeoutStartSec=180
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/market-intelligence/data/processed
PrivateTmp=true

[Install]
WantedBy=default.target

